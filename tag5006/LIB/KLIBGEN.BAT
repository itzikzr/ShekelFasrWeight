@ECHO OFF
ECHO GENERATING THE %1 LIBRARY
SET C51INC=D:\C51V4\INC
SET C51LIB=D:\C51V4\LIB
ECHO LIBRARY COMPILATION REPORT > MESSAGE
IF EXIST $$$ ERASE $$$ > NUL
FOR %%F IN (*.C) DO CALL KALLC %%F
IF ERRORLEVEL 1 GOTO FAIL
FOR %%F IN (*.ASM) DO CALL KALLA %%F
IF ERRORLEVEL 1 GOTO FAIL
IF EXIST %1.LIB ERASE %1.LIB > NUL
D:\C51V4\BIN\LIB51 CREATE %1.LIB >> MESSAGE
IF ERRORLEVEL GOTO FAIL
FOR %%F IN (*.OBJ) DO CALL KLIBADD %%F %1
IF NOT ERRORLEVEL 1 GOTO END
:FAIL
:TYPE C:\DOS\BELL
beep
IF EXIST $$$ ERASE $$$
TYPE MESSAGE | MORE
:END
IF EXIST $$$ GOTO FAIL